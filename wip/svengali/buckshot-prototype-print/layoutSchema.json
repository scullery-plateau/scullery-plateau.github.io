{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanvasLayout",
  "type": "object",
    "required": [
    "orientation",
    "layers"
  ],
  "properties": {
    "orientation": {
      "type": "string",
      "enum": ["portrait", "landscape"],
      "description": "Determines the card dimensions (Portrait: 240x336, Landscape: 336x240)."
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "additionalProperties": false,
    "$defs": {
    "stringBinding": {
      "oneOf": [
        {
          "type": "string",
          "description": "A static value that ignores the data record."
        },
        {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "A path to a value in the data record."
        },
        {
          "type": "object",
          "properties": {
            "path": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "default": { "type": "string" }
          },
          "required": ["path", "default"],
          "additionalProperties": false,
          "description": "A path to a record value, with a fallback static value."
        }
      ]
    },
    "numberBinding": {
      "oneOf": [
        { "type": "number" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        {
          "type": "object",
          "properties": {
            "path": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "default": { "type": "number" }
          },
          "required": ["path", "default"],
          "additionalProperties": false
        }
      ]
    },
    "booleanBinding": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        {
          "type": "object",
          "properties": {
            "path": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "default": { "type": "boolean" }
          },
          "required": ["path", "default"],
          "additionalProperties": false
        }
      ]
    },
    "colorBinding": {
      "oneOf": [
        { "$ref": "#/$defs/colorSpec" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        {
          "type": "object",
          "properties": {
            "path": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "default": { "$ref": "#/$defs/colorSpec" }
          },
          "required": ["path", "default"],
          "additionalProperties": false
        }
      ]
    },
    "textAlignment": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right",
        "justify"
      ]
    },
        "colorSpec": {
      "type": "string",
      "anyOf": [
        { "pattern": "^#[0-9a-fA-F]{6}$" },
        {
          "enum": [
            "aliceblue", "antiquewhite", "aqua", "aquamarine", "azure", "beige", "bisque", "black", 
            "blanchedalmond", "blue", "blueviolet", "brown", "burlywood", "cadetblue", "chartreuse", 
            "chocolate", "coral", "cornflowerblue", "cornsilk", "crimson", "cyan", "darkblue", 
            "darkcyan", "darkgoldenrod", "darkgray", "darkgreen", "darkgrey", "darkkhaki", 
            "darkmagenta", "darkolivegreen", "darkorange", "darkorchid", "darkred", "darksalmon", 
            "darkseagreen", "darkslateblue", "darkslategray", "darkslategrey", "darkturquoise", 
            "darkviolet", "deeppink", "deepskyblue", "dimgray", "dimgrey", "dodgerblue", 
            "firebrick", "floralwhite", "forestgreen", "fuchsia", "gainsboro", "ghostwhite", 
            "gold", "goldenrod", "gray", "green", "greenyellow", "grey", "honeydew", "hotpink", 
            "indianred", "indigo", "ivory", "khaki", "lavender", "lavenderblush", "lawngreen", 
            "lemonchiffon", "lightblue", "lightcoral", "lightcyan", "lightgoldenrodyellow", 
            "lightgray", "lightgreen", "lightgrey", "lightpink", "lightsalmon", "lightseagreen", 
            "lightskyblue", "lightslategray", "lightslategrey", "lightsteelblue", "lightyellow", 
            "lime", "limegreen", "linen", "magenta", "maroon", "mediumaquamarine", "mediumblue", 
            "mediumorchid", "mediumpurple", "mediumseagreen", "mediumslateblue", "mediumspringgreen", 
            "mediumturquoise", "mediumvioletred", "midnightblue", "mintcream", "mistyrose", 
            "moccasin", "navajowhite", "navy", "oldlace", "olive", "olivedrab", "orange", 
            "orangered", "orchid", "palegoldenrod", "palegreen", "paleturquoise", "palevioletred", 
            "papayawhip", "peachpuff", "peru", "pink", "plum", "powderblue", "purple", 
            "rebeccapurple", "red", "rosybrown", "royalblue", "saddlebrown", "salmon", "sandybrown", 
            "seagreen", "seashell", "sienna", "silver", "skyblue", "slateblue", "slategray", 
            "slategrey", "snow", "springgreen", "steelblue", "tan", "teal", "thistle", "tomato", 
            "turquoise", "violet", "wheat", "white", "whitesmoke", "yellow", "yellowgreen"
          ]
        }
      ]
    },
        "BaseLayer": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "$ref": "#/$defs/numberBinding" },
        "y": { "$ref": "#/$defs/numberBinding" },
        "width": { "$ref": "#/$defs/numberBinding" },
        "height": { "$ref": "#/$defs/numberBinding" },
        "backgroundColor": { "$ref": "#/$defs/colorBinding" },
        "outlineColor": { "$ref": "#/$defs/colorBinding" },
        "outlineWidth": { "$ref": "#/$defs/numberBinding" },
        "outlineStyle": { "$ref": "#/$defs/stringBinding" }
      }
    },
        "HeaderLayer": {
      "allOf": [{ "$ref": "#/$defs/BaseLayer" }],
      "type": "object",
      "required": ["header"],
      "properties": {
        "header": {
          "type": "object",
          "required": ["property", "align"],
          "properties": {
            "property": { "$ref": "#/$defs/stringBinding" },
            "align": { "$ref": "#/$defs/textAlignment" },
            "font": { "$ref": "#/$defs/stringBinding" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
        "IconLayer": {
      "allOf": [{ "$ref": "#/$defs/BaseLayer" }],
      "type": "object",
      "required": ["icon"],
      "properties": {
        "icon": {
          "type": "object",
          "required": ["property", "fill"],
          "properties": {
            "property": { "$ref": "#/$defs/stringBinding" },
            "fill": { "$ref": "#/$defs/colorBinding" },
            "scale": {
              "oneOf": [
                { "$ref": "#/$defs/numberBinding" },
                {
                  "type": "object",
                  "properties": {
                    "x": { "$ref": "#/$defs/numberBinding" },
                    "y": { "$ref": "#/$defs/numberBinding" }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "rotate": { "$ref": "#/$defs/numberBinding" },
            "preserveAspectRatio": { "$ref": "#/$defs/booleanBinding" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
        "ParagraphLayer": {
      "allOf": [{ "$ref": "#/$defs/BaseLayer" }],
      "type": "object",
      "required": ["paragraph"],
      "properties": {
        "paragraph": {
          "type": "object",
          "required": ["property", "align", "wrap"],
          "properties": {
            "property": { "$ref": "#/$defs/stringBinding" },
            "align": { "$ref": "#/$defs/textAlignment" },
            "wrap": { "$ref": "#/$defs/booleanBinding" },
            "font": { "$ref": "#/$defs/stringBinding" },
            "lineHeight": { "$ref": "#/$defs/numberBinding" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "oneOf": [
        {
          "$ref": "#/$defs/HeaderLayer"
        },
        {
          "$ref": "#/$defs/IconLayer"
        },
        {
          "$ref": "#/$defs/ParagraphLayer"
        }
      ]
    }
  }
}
